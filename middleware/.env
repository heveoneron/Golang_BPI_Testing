# Environment Configuration - BPI Testing Middleware

APP_PORT=8085

# PostgreSQL Connection String (Lokal Staging DB)
PG_CONN_STRING=postgres://postgres:postgres123@localhost:5432/bpi_middleware_db?sslmode=disable

# SQL Server 2019 / 2012 Connection String (Maximo DB)
# Format standard go-mssqldb:
# sqlserver://username:password@host:port?database=dbname&encrypt=disable
# Contoh lokal SQL Server 2019:
# SQL_CONN_STRING=sqlserver://sa:YourPassword123!@localhost:1433?database=MAXIMO_STAGING&encrypt=disable
SQL_CONN_STRING=sqlserver://sa:password@localhost:1433?database=MAX_BPI_TEST&encrypt=disable

# SAP Grow OData Credentials
SAP_BASE_URL=https://my445160-api.s4hana.cloud.sap
SAP_USER=CU_SAP_COM_0053
SAP_PASS=PowerofOne@123456789

# Auto Pull Settings (Auto Get Data from Maximo)
# Nilai: "true" (Aktif) atau "false" (Nonaktif/Mati)
# Jika false/off, penarikan otomatis berhenti, namun tombol manual pull di panel tetap bisa digunakan
AUTO_PULL_ENABLED=true
PULL_INTERVAL_MINUTES=3
PULL_BATCH_LIMIT=1

