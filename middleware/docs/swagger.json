{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Middleware integrasi enterprise: IBM Maximo \u003c-\u003e PostgreSQL Staging \u0026 State Machine \u003c-\u003e SAP Grow S/4HANA Cloud OData.",
        "title": "BPI Maximo to SAP Grow Middleware Engine API",
        "contact": {
            "name": "BPI Middleware Development Team"
        },
        "version": "1.0"
    },
    "host": "localhost:8085",
    "basePath": "/api/v1",
    "paths": {
        "/documents": {
            "get": {
                "description": "Mengambil hingga 50 data dokumen antrean \u0026 status integrasi SAP dari tabel documents",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Monitoring"
                ],
                "summary": "Lihat Daftar Core Documents",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.GetDocumentsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/exchange-rate": {
            "post": {
                "description": "Menerima payload kurs.updated dari Maximo/Kemenkeu, menyimpan ke exchange_rates, dan mencatat audit trail di integration_logs",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Exchange Rate"
                ],
                "summary": "Menerima Update Kurs Pajak / Exchange Rate dari Maximo",
                "parameters": [
                    {
                        "description": "Payload Kurs Pajak dari Maximo / Kemenkeu",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.MaximoExchangeRatePayload"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/exchange-rates": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Exchange Rate"
                ],
                "summary": "Mengambil Daftar History Exchange Rate",
                "responses": {}
            }
        },
        "/health": {
            "get": {
                "description": "Memeriksa status service BPI Maximo-SAP Grow Middleware",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Health Check Service",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.HealthResponse"
                        }
                    }
                }
            }
        },
        "/ingest/po": {
            "post": {
                "description": "Simulasi webhook atau inject payload PO Maximo secara langsung ke staging_documents dan mentransformasikannya ke documents",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Ingestion"
                ],
                "summary": "Ingest Manual PO Maximo",
                "parameters": [
                    {
                        "description": "Maximo PO Header JSON Payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.MaximoPOHeader"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.IngestManualPOResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/integration-logs": {
            "get": {
                "description": "Mendapatkan riwayat audit trail pertukaran data Maximo \u003c-\u003e Middleware \u003c-\u003e SAP",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Logs"
                ],
                "summary": "Get integration audit trail logs",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter Document Type",
                        "name": "document_type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter Document No",
                        "name": "document_no",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/sap/endpoints": {
            "get": {
                "description": "Menampilkan semua konfigurasi endpoint, skenario komunikasi, dan kredensial SAP S/4HANA Cloud",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "SAP Endpoints"
                ],
                "summary": "Mengambil Daftar Semua Endpoint SAP Terdaftar",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Menyimpan atau mengupdate URL, OData Version, dan kredensial Communication User untuk integrasi SAP",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "SAP Endpoints"
                ],
                "summary": "Menyimpan atau Memperbarui Konfigurasi Endpoint SAP",
                "parameters": [
                    {
                        "description": "Data Konfigurasi Endpoint SAP",
                        "name": "endpoint",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.SAPEndpoint"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/sap/endpoints/test": {
            "post": {
                "description": "Melakukan uji coba konektivitas HTTP dan handshake pengambilan x-csrf-token dari server SAP S/4HANA Cloud",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "SAP Endpoints"
                ],
                "summary": "Uji Koneksi \u0026 Handshake CSRF Token ke SAP Grow",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Kode Layanan SAP (PO, BP, PRODUCT, dll)",
                        "name": "service_code",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/sap/execute-test": {
            "post": {
                "description": "Mengirimkan payload HTTP POST / PATCH / GET langsung ke server SAP Grow S/4HANA Cloud dengan auto CSRF handshake \u0026 Basic Auth",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "SAP Sandbox"
                ],
                "summary": "Eksekusi Payload Test ke SAP Grow (Sandbox Tester)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/sap/material-document/{doc_no}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "SAP Inspection"
                ],
                "summary": "Mengecek Live Detail Material Document / Goods Receipt dari SAP Grow",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Material Document No (e.g. 202500000001 or 5000000000)",
                        "name": "doc_no",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Material Document Year (default: 2025)",
                        "name": "year",
                        "in": "query"
                    }
                ],
                "responses": {}
            }
        },
        "/scheduler/status": {
            "get": {
                "description": "Memeriksa status aktif/nonaktif fitur penarikan data otomatis dari Maximo (berdasarkan .env dan DB)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Scheduler"
                ],
                "summary": "Cek Status Pengaturan Auto-Pull",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.SchedulerStatusResponse"
                        }
                    }
                }
            }
        },
        "/scheduler/toggle": {
            "post": {
                "description": "Mengubah status aktif/nonaktif auto get data from Maximo pada database runtime",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Scheduler"
                ],
                "summary": "Ubah Status On/Off Auto-Pull di Database",
                "parameters": [
                    {
                        "type": "boolean",
                        "description": "Status aktif (true/false)",
                        "name": "active",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.SchedulerStatusResponse"
                        }
                    }
                }
            }
        },
        "/trigger/pull": {
            "post": {
                "description": "Memicu eksekusi manual worker pull untuk menarik data antrean mxout_inter_trans dari SQL Server Maximo ke PostgreSQL staging_documents",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Ingestion"
                ],
                "summary": "Trigger Pull Worker dari SQL Server Maximo",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Jumlah data yang mau ditarik (Default: 1 untuk testing)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.TriggerPullResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/trigger/push": {
            "post": {
                "description": "Memicu eksekusi manual worker push untuk mengirim dokumen pending ke SAP Grow OData",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Dispatching"
                ],
                "summary": "Trigger Push Dispatcher ke SAP Grow",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.TriggerPushResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/uom-mappings": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "UOM Mapping"
                ],
                "summary": "Mengambil Daftar Master Data Pemetaan UOM Maximo ke SAP",
                "responses": {}
            }
        }
    },
    "definitions": {
        "controller.DocumentItemDTO": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string",
                    "example": "2026-10-12T14:00:00Z"
                },
                "doc_type": {
                    "type": "string",
                    "example": "PO"
                },
                "document_no": {
                    "type": "string",
                    "example": "PO-BPI-2026-001"
                },
                "group_id": {
                    "type": "string",
                    "example": "GRP-PO-PO-BPI-2026-001"
                },
                "id": {
                    "type": "string",
                    "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
                },
                "raw_payload": {
                    "type": "object"
                },
                "retry_count": {
                    "type": "integer",
                    "example": 0
                },
                "sap_document_no": {
                    "type": "string",
                    "example": "SAP-PO-1730000000"
                },
                "sap_payload": {
                    "type": "object"
                },
                "status": {
                    "type": "string",
                    "example": "pending"
                }
            }
        },
        "controller.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "invalid request body"
                }
            }
        },
        "controller.GetDocumentsResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controller.DocumentItemDTO"
                    }
                },
                "total": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "controller.HealthResponse": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string",
                    "example": "BPI Maximo-SAP Grow Middleware"
                },
                "status": {
                    "type": "string",
                    "example": "running"
                }
            }
        },
        "controller.IngestManualPOResponse": {
            "type": "object",
            "properties": {
                "document_no": {
                    "type": "string",
                    "example": "PO-BPI-2026-001"
                },
                "message": {
                    "type": "string",
                    "example": "PO successfully ingested into staging_documents and transformed to core documents"
                },
                "transformed": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "controller.SchedulerStatusResponse": {
            "type": "object",
            "properties": {
                "auto_pull_enabled": {
                    "type": "boolean",
                    "example": true
                },
                "batch_limit": {
                    "type": "integer",
                    "example": 1
                },
                "env_setting": {
                    "type": "string",
                    "example": "true"
                },
                "message": {
                    "type": "string",
                    "example": "Auto-pull status di database berhasil diatur"
                },
                "status": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "controller.TriggerPullResponse": {
            "type": "object",
            "properties": {
                "limit": {
                    "type": "integer",
                    "example": 1
                },
                "message": {
                    "type": "string",
                    "example": "Pull trigger executed successfully"
                },
                "pulled_count": {
                    "type": "integer",
                    "example": 1
                },
                "transformed": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "controller.TriggerPushResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Push trigger executed"
                },
                "pushed_count": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "model.ExchangeRateItem": {
            "type": "object",
            "properties": {
                "change": {
                    "type": "number"
                },
                "currency_code": {
                    "type": "string"
                },
                "currency_name": {
                    "type": "string"
                },
                "rate": {
                    "type": "number"
                },
                "rate_per_unit": {
                    "type": "string"
                },
                "unit": {
                    "type": "integer"
                }
            }
        },
        "model.ExchangeRatePeriod": {
            "type": "object",
            "properties": {
                "document_url": {
                    "type": "string"
                },
                "kmk_number": {
                    "type": "string"
                },
                "valid_from": {
                    "type": "string"
                },
                "valid_to": {
                    "type": "string"
                }
            }
        },
        "model.MaximoExchangeRatePayload": {
            "type": "object",
            "properties": {
                "event": {
                    "type": "string"
                },
                "period": {
                    "$ref": "#/definitions/model.ExchangeRatePeriod"
                },
                "rates": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.ExchangeRateItem"
                    }
                },
                "sent_at": {
                    "type": "string"
                },
                "source": {
                    "type": "string"
                }
            }
        },
        "model.MaximoPOHeader": {
            "type": "object",
            "properties": {
                "CURRENCYCODE": {
                    "type": "string",
                    "example": "IDR"
                },
                "LINES": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.MaximoPOLine"
                    }
                },
                "ORDERDATE": {
                    "type": "string",
                    "example": "2026-10-12"
                },
                "PONUM": {
                    "type": "string",
                    "example": "PO-BPI-2026-001"
                },
                "REVISIONNUM": {
                    "type": "integer",
                    "example": 0
                },
                "STATUS": {
                    "type": "string",
                    "example": "APPR"
                },
                "VENDOR": {
                    "type": "string",
                    "example": "VEND-PLTU-01"
                }
            }
        },
        "model.MaximoPOLine": {
            "type": "object",
            "properties": {
                "BUDGETCODE": {
                    "type": "string",
                    "example": "10081"
                },
                "DEPARTMENT": {
                    "type": "string",
                    "example": "3000"
                },
                "ITEMNUM": {
                    "type": "string",
                    "example": "BEARING-TURBINE-6204"
                },
                "LINETYPE": {
                    "type": "string",
                    "example": "ITEM"
                },
                "MAINACCOUNT": {
                    "type": "string",
                    "example": "513043"
                },
                "ORDERUNIT": {
                    "type": "string",
                    "example": "PCS"
                },
                "POLINENUM": {
                    "type": "integer",
                    "example": 1
                },
                "PRLINENUM": {
                    "type": "integer",
                    "example": 1
                },
                "PRNUM": {
                    "type": "string",
                    "example": "PR-2026-001"
                },
                "QTY": {
                    "type": "number",
                    "example": 5
                },
                "TAXCODE1": {
                    "type": "string",
                    "example": "V1"
                },
                "UNITCOST": {
                    "type": "number",
                    "example": 150000
                }
            }
        },
        "model.SAPEndpoint": {
            "type": "object",
            "properties": {
                "base_url": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "csrf_path": {
                    "type": "string"
                },
                "endpoint_path": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "is_active": {
                    "type": "boolean"
                },
                "last_response": {
                    "type": "string"
                },
                "last_status": {
                    "type": "string"
                },
                "last_tested_at": {
                    "type": "string"
                },
                "odata_version": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                },
                "scenario_id": {
                    "type": "string"
                },
                "service_code": {
                    "type": "string"
                },
                "service_name": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        }
    }
}