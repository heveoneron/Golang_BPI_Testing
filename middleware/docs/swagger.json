{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Middleware integrasi enterprise: IBM Maximo \u003c-\u003e PostgreSQL Staging \u0026 State Machine \u003c-\u003e SAP Grow S/4HANA Cloud OData.",
        "title": "BPI Maximo to SAP Grow Middleware Engine API",
        "contact": {
            "name": "BPI Middleware Development Team"
        },
        "version": "1.0"
    },
    "host": "localhost:8085",
    "basePath": "/api/v1",
    "paths": {
        "/documents": {
            "get": {
                "description": "Mengambil hingga 50 data dokumen antrean \u0026 status integrasi SAP dari tabel documents",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Monitoring"
                ],
                "summary": "Lihat Daftar Core Documents",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_controller.GetDocumentsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_controller.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/internal_controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Memeriksa status service BPI Maximo-SAP Grow Middleware",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Health Check Service",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_controller.HealthResponse"
                        }
                    }
                }
            }
        },
        "/ingest/po": {
            "post": {
                "description": "Simulasi webhook atau inject payload PO Maximo secara langsung ke staging_documents dan mentransformasikannya ke documents",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Ingestion"
                ],
                "summary": "Ingest Manual PO Maximo",
                "parameters": [
                    {
                        "description": "Maximo PO Header JSON Payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/golang-bpi-testing_internal_model.MaximoPOHeader"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_controller.IngestManualPOResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_controller.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_controller.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/internal_controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/trigger/pull": {
            "post": {
                "description": "Memicu eksekusi manual worker pull untuk menarik data antrean mxout_inter_trans dari SQL Server Maximo ke PostgreSQL staging_documents",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Ingestion"
                ],
                "summary": "Trigger Pull Worker dari SQL Server Maximo",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Jumlah data yang mau ditarik (Default: 1 untuk testing)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_controller.TriggerPullResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/internal_controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/trigger/push": {
            "post": {
                "description": "Memicu eksekusi manual worker push untuk mengirim dokumen pending ke SAP Grow OData",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Dispatching"
                ],
                "summary": "Trigger Push Dispatcher ke SAP Grow",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_controller.TriggerPushResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/internal_controller.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "golang-bpi-testing_internal_model.MaximoPOHeader": {
            "type": "object",
            "properties": {
                "CURRENCYCODE": {
                    "type": "string",
                    "example": "IDR"
                },
                "LINES": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/golang-bpi-testing_internal_model.MaximoPOLine"
                    }
                },
                "ORDERDATE": {
                    "type": "string",
                    "example": "2026-10-12"
                },
                "PONUM": {
                    "type": "string",
                    "example": "PO-BPI-2026-001"
                },
                "REVISIONNUM": {
                    "type": "integer",
                    "example": 0
                },
                "STATUS": {
                    "type": "string",
                    "example": "APPR"
                },
                "VENDOR": {
                    "type": "string",
                    "example": "VEND-PLTU-01"
                }
            }
        },
        "golang-bpi-testing_internal_model.MaximoPOLine": {
            "type": "object",
            "properties": {
                "BUDGETCODE": {
                    "type": "string",
                    "example": "10081"
                },
                "DEPARTMENT": {
                    "type": "string",
                    "example": "3000"
                },
                "ITEMNUM": {
                    "type": "string",
                    "example": "BEARING-TURBINE-6204"
                },
                "LINETYPE": {
                    "type": "string",
                    "example": "ITEM"
                },
                "MAINACCOUNT": {
                    "type": "string",
                    "example": "513043"
                },
                "ORDERUNIT": {
                    "type": "string",
                    "example": "PCS"
                },
                "POLINENUM": {
                    "type": "integer",
                    "example": 1
                },
                "PRLINENUM": {
                    "type": "integer",
                    "example": 1
                },
                "PRNUM": {
                    "type": "string",
                    "example": "PR-2026-001"
                },
                "QTY": {
                    "type": "number",
                    "example": 5
                },
                "TAXCODE1": {
                    "type": "string",
                    "example": "V1"
                },
                "UNITCOST": {
                    "type": "number",
                    "example": 150000
                }
            }
        },
        "internal_controller.DocumentItemDTO": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string",
                    "example": "2026-10-12T14:00:00Z"
                },
                "doc_type": {
                    "type": "string",
                    "example": "PO"
                },
                "document_no": {
                    "type": "string",
                    "example": "PO-BPI-2026-001"
                },
                "group_id": {
                    "type": "string",
                    "example": "GRP-PO-PO-BPI-2026-001"
                },
                "id": {
                    "type": "string",
                    "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
                },
                "raw_payload": {
                    "type": "object"
                },
                "retry_count": {
                    "type": "integer",
                    "example": 0
                },
                "sap_document_no": {
                    "type": "string",
                    "example": "SAP-PO-1730000000"
                },
                "sap_payload": {
                    "type": "object"
                },
                "status": {
                    "type": "string",
                    "example": "pending"
                }
            }
        },
        "internal_controller.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "invalid request body"
                }
            }
        },
        "internal_controller.GetDocumentsResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_controller.DocumentItemDTO"
                    }
                },
                "total": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "internal_controller.HealthResponse": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string",
                    "example": "BPI Maximo-SAP Grow Middleware"
                },
                "status": {
                    "type": "string",
                    "example": "running"
                }
            }
        },
        "internal_controller.IngestManualPOResponse": {
            "type": "object",
            "properties": {
                "document_no": {
                    "type": "string",
                    "example": "PO-BPI-2026-001"
                },
                "message": {
                    "type": "string",
                    "example": "PO successfully ingested into staging_documents and transformed to core documents"
                },
                "transformed": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "internal_controller.TriggerPullResponse": {
            "type": "object",
            "properties": {
                "limit": {
                    "type": "integer",
                    "example": 1
                },
                "message": {
                    "type": "string",
                    "example": "Pull trigger executed successfully"
                },
                "pulled_count": {
                    "type": "integer",
                    "example": 1
                },
                "transformed": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "internal_controller.TriggerPushResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Push trigger executed"
                },
                "pushed_count": {
                    "type": "integer",
                    "example": 1
                }
            }
        }
    }
}