# Environment Configuration - BPI Testing Middleware

APP_PORT=8085

# PostgreSQL Connection String (Lokal Staging DB)
PG_CONN_STRING=postgres://postgres:postgres@localhost:5432/bpi_middleware_db?sslmode=disable

# SQL Server 2019 / 2012 Connection String (Maximo DB)
# Format standard go-mssqldb:
# sqlserver://username:password@host:port?database=dbname&encrypt=disable
# Contoh lokal SQL Server 2019:
# SQL_CONN_STRING=sqlserver://sa:YourPassword123!@localhost:1433?database=MAXIMO_STAGING&encrypt=disable
SQL_CONN_STRING=

# SAP Grow OData Credentials
# Gunakan "MOCK" untuk pengujian lokal tanpa server SAP aktif
SAP_BASE_URL=MOCK
SAP_USER=TEST_USER
SAP_PASS=TEST_PASSWORD

# ---------------- Finance Integration (RICEF 1-9) ----------------
# Endpoint finance di-seed tanpa password; bila kolom password di sap_endpoints kosong,
# Engine memakai SAP_PASS di atas. Ubah password per technical user lewat Panel > SAP Integration.
FIN_COMPANY_CODE=5110
# Finance Pull Worker (RICEF 3/4 GL, 5 Payment Proposal, 9 Fixed Asset)
FIN_PULL_ENABLED=true
FIN_PULL_INTERVAL_MINUTES=60
# Tipe dokumen akuntansi untuk RICEF 3 (jurnal) dan RICEF 4 (invoice non-PO)
FIN_JE_DOC_TYPES=SA,AB
FIN_INVOICE_DOC_TYPES=KR,KG
# RICEF 2 Journal Entry GI (SOAP): user pembuat & logical system (opsional)
FIN_JE_CREATED_BY_USER=
FIN_LOGICAL_SYSTEM=
# RICEF 6 Exchange Rate KMK
FIN_EXRATE_AUTO_PUSH=true
FIN_EXRATE_TYPE=M
FIN_EXRATE_TARGET_CURRENCY=IDR
# RICEF 7 Supplier Invoice (Reimbursement & Business Trip)
FIN_INVOICE_DEFAULT_TAX_CODE=V0
FIN_INVOICE_PAYMENT_TERMS=NT15
FIN_INVOICE_STATUS=A

# ---------------- SAP -> Maximo (dbo.mxinvoice) ----------------
# Tulis otomatis invoice & jurnal SAP ke Maximo tiap siklus Finance Pull Worker (default mati).
FIN_MAXIMO_EXPORT_ENABLED=false
# Filter status supplier invoice yang ditarik (kosong = semua)
FIN_INVOICE_PULL_STATUS=
FIN_MAXIMO_SITEID=BTNG
FIN_MAXIMO_LINETYPE=SERVICE
FIN_MAXIMO_INVOICE_IFACE=MXINVOICE
FIN_MAXIMO_EXTSYSNAME=SAP_GROW
