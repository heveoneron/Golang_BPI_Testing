# Environment Configuration - BPI Testing Middleware

APP_PORT=8085

# PostgreSQL Connection String (Lokal Staging DB)
PG_CONN_STRING=postgres://postgres:postgres@localhost:5432/bpi_middleware_db?sslmode=disable

# SQL Server 2019 / 2012 Connection String (Maximo DB)
# Format standard go-mssqldb:
# sqlserver://username:password@host:port?database=dbname&encrypt=disable
# Contoh lokal SQL Server 2019:
# SQL_CONN_STRING=sqlserver://sa:YourPassword123!@localhost:1433?database=MAXIMO_STAGING&encrypt=disable
SQL_CONN_STRING=

# SAP Grow OData Credentials
# Gunakan "MOCK" untuk pengujian lokal tanpa server SAP aktif
SAP_BASE_URL=MOCK
SAP_USER=TEST_USER
SAP_PASS=TEST_PASSWORD
