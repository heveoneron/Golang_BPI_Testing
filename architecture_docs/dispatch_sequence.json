    {
      "dot": "emerald",
      "title": "Relational Queue Pull",
      "items": [
        "Poller worker extracts pending batches from SQL Server queue",
        "Orphan verification ensures each header has matching detail items",
        "Raw payload is safely stored in PostgreSQL staging_documents"
      ]
    },
    {
      "dot": "cyan",
      "title": "SAP Cloud Session Handshake",
      "items": [
        "First call fetches a dynamic CSRF token and session cookies",
        "Security credentials are kept in memory for the dispatch session",
        "OData POST payload is submitted with valid CSRF and cookie headers"
      ]
    },
    {
      "dot": "rose",
      "title": "Two-Phase Commitment",
      "items": [
        "Successful SAP responses yield an official SAP Document Number",
        "Source SQL Server queue is updated to mark transaction processed",
        "Complete payload and response are saved to PostgreSQL audit logs"
      ]
    }
