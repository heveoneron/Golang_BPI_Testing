  "cards": [
    {
      "dot": "cyan",
      "title": "EAM & Staging Source",
      "items": [
        "IBM Maximo generates maintenance documents and logs queue records",
        "SQL Server holds outbound queues and interface detail tables",
        "Automatic orphan validation ensures complete header and line records"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dual-Thread Middleware Engine",
      "items": [
        "Independent Pull Worker extracts new records on a 3-minute ticker",
        "PostgreSQL provides a durable 3-tier staging buffer with JSON snapshots",
        "Push Dispatcher executes atomic delivery to SAP Grow with session management"
      ]
    },
    {
      "dot": "violet",
      "title": "Operations & Enterprise Cloud",
      "items": [
        "Operations Web Panel gives real-time tracking, metrics, and manual triggers",
        "Interactive payload inspector allows side-by-side comparison",
        "SAP Grow S/4HANA Cloud receives verified transactions via OData services"
      ]
    }
  ]
