# ==============================================================================
# BPI MIDDLEWARE ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Salin file ini menjadi .env jika ingin mengubah konfigurasi default:
#   cp .env.example .env
# ==============================================================================

# Database PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=bpi_middleware_db
POSTGRES_PORT=5432

# Ports Aplikasi
MIDDLEWARE_PORT=8085
PANEL_PORT=8091

# Kredensial Administrator Web Panel
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASS=admin
SESSION_SECRET=kunci_rahasia_bpi_panel_2026

# Koneksi Database Maximo SQL Server
# Jika SQL Server di mesin host yang sama dengan Docker, gunakan: host.docker.internal
# Jika di server terpisah, ganti dengan IP SQL Server Maximo (contoh: 192.168.x.x)
SQL_CONN_STRING=sqlserver://sa:password@host.docker.internal:1433?database=MAX_BPI_TEST&encrypt=disable

# Kredensial Resmi SAP S/4HANA Grow Cloud
SAP_BASE_URL=https://my445160-api.s4hana.cloud.sap
SAP_USER=CU_SAP_COM_0053
SAP_PASS=PowerofOne@123456789

# Auto-Pull Maximo Poller
AUTO_PULL_ENABLED=false
PULL_INTERVAL_MINUTES=3
PULL_BATCH_LIMIT=1
