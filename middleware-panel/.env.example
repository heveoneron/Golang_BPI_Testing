# Middleware Panel Configuration (.env)
APP_PORT=8091
SESSION_SECRET=kunci_rahasia_bpi_panel_2026

# Panel Local Admin Credentials (Kredensial login panel)
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASS=admin

# Opsional: Jika menggunakan auth API backend eksternal (kosongkan jika pakai admin lokal)
LOGIN_API_URL=

# PostgreSQL Connection (Same database as middleware)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bpi_middleware_db

# Middleware Engine API (Untuk trigger sync/push dari panel)
MIDDLEWARE_API_URL=http://localhost:8085/api/v1
API_URL=http://localhost:8085/api/v1
BACKUP_API_URL=http://localhost:8085/api/backup

BACKUP_API_USER=admin
BACKUP_API_PASS=admin123
