# Environment Configuration - BPI Testing Middleware

APP_PORT=8085

# PostgreSQL Connection String (Lokal Staging DB)
PG_CONN_STRING=postgres://postgres:postgres123@127.0.0.1:5432/bpi_middleware_db?sslmode=disable

# SQL Server 2012 Connection String (Maximo DB)
# Kosongkan atau biarkan default untuk menjalankan mock mode
SQL_CONN_STRING=

# SAP Grow OData Credentials
# Gunakan "MOCK" untuk pengujian lokal tanpa server SAP aktif
SAP_BASE_URL=MOCK
SAP_USER=TEST_USER
SAP_PASS=TEST_PASSWORD
